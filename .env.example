# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth Client (Google Cloud Console -> APIs & Services -> Credentials)
# Enable Google Sheets API + Search Console API for this project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin allowlist (comma-separated emails, lowercase)
ADMIN_EMAILS=

# Google Sheet source (content_urls tab: project | url | member_name | date | type)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=content_urls

# Neon/Postgres
DATABASE_URL=

# Data Sync v2 tuning (optional)
SYNC_GSC_CONCURRENCY=4
SYNC_GSC_WIDE_QUERY=true
SYNC_GSC_REQUEST_TIMEOUT_MS=30000
SYNC_GSC_RETRY_ATTEMPTS=5
SYNC_GSC_MAX_REQUESTS_PER_RUN=20000
SYNC_GSC_EXACT_CHUNK_SIZE=50
SYNC_REFRESH_ITEM_LEASE_SECONDS=90
SYNC_BULK_CHUNK_SIZE=500
SYNC_STALE_RUN_MINUTES=15
SYNC_DATE_FORMAT_HINT=dmy
