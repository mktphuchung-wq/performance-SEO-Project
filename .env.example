# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth Client (Google Cloud Console -> APIs & Services -> Credentials)
# Enable Google Sheets API + Search Console API for this project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin allowlist (comma-separated emails, lowercase)
ADMIN_EMAILS=

# Google Sheet source (content_urls tab: project | url | member_name | date | type)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=content_urls

# Neon/Postgres
DATABASE_URL=
