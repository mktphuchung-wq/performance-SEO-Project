{
  "name": "performance-seo-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:refresh": "node scripts/verify-refresh-range.mjs && node scripts/verify-refresh-workflow.mjs",
    "verify:refresh-db": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/verify-refresh-db.mjs",
    "verify:refresh-preflight-db": "node --experimental-transform-types --import ./scripts/alias-loader.mjs scripts/verify-refresh-preflight-db.mjs",
    "verify:work-events": "node scripts/verify-work-events.mjs",
    "verify:work-events-db": "node scripts/verify-work-events-db.mjs",
    "verify:review-autosync": "node scripts/verify-review-autosync.mjs",
    "verify:anomaly-baseline": "node scripts/verify-anomaly-baseline.mjs",
    "verify:score": "node scripts/verify-score.mjs",
    "verify:member-score": "node scripts/verify-member-score.mjs",
    "verify:member-score-db": "node scripts/verify-member-score-db.mjs",
    "verify:warning-audit": "node scripts/verify-warning-audit.mjs",
    "verify:warning-audit-db": "node scripts/verify-warning-audit-db.mjs",
    "verify:warning-evaluation": "node --import ./scripts/alias-loader.mjs scripts/verify-warning-evaluation.mjs",
    "verify:table-view": "node --no-warnings --experimental-strip-types scripts/verify-table-view.mjs",
    "report:kpi-shift": "node --import ./scripts/alias-loader.mjs scripts/report-kpi-shift.mjs",
    "verify:kpi": "npm run verify:score && npm run verify:member-score && npm run verify:warning-audit",
    "migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "googleapis": "^174.0.0",
    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
